<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= I18n.t('ui.title') %></title>
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <main>
    <header class="intro">
      <p class="eyebrow"><%= I18n.t('ui.eyebrow') %></p>
      <h1><%= I18n.t('ui.title') %></h1>
      <p><%= I18n.t('ui.intro') %></p>
    </header>
    <section class="panel search" aria-labelledby="search-title">
      <h2 id="search-title"><%= I18n.t('ui.search_title') %></h2>
      <form id="search-form">
        <div class="fields">
          <label><%= I18n.t('ui.latitude') %><input id="lat" name="lat" type="number" min="-90" max="90" step="any" required inputmode="decimal"></label>
          <label><%= I18n.t('ui.longitude') %><input id="lon" name="lon" type="number" min="-180" max="180" step="any" required inputmode="decimal"></label>
          <label><%= I18n.t('ui.radius') %><input id="radius" name="radius_km" type="number" min="1" max="20" step="1" value="5" required inputmode="numeric"></label>
        </div>
        <div class="actions">
          <button type="button" id="locate"><%= I18n.t('ui.locate') %></button>
          <button type="submit" class="primary"><%= I18n.t('ui.search') %></button>
        </div>
      </form>
      <p id="status" role="status" aria-live="polite"></p>
    </section>
    <section id="result" class="panel card" aria-labelledby="result-title" hidden>
      <div class="card-head"><h2 id="result-title"><%= I18n.t('ui.card_title') %></h2><button type="button" id="print"><%= I18n.t('ui.print') %></button></div>
      <div id="card-content"></div>
    </section>
  </main>
  <script id="ui-strings" type="application/json"><%= JSON.generate(I18n.t('ui')).gsub('<', '\\u003c').gsub('>', '\\u003e').gsub('&', '\\u0026') %></script>
</body>
</html>
